@model PantryViewModel
@{
    ViewData["Title"] = "Your pantry";
}

<h1>Your pantry</h1>

<p>Tick what you usually have at home. Mau treats these as ingredients you already have, so they are not listed as still needed. Water, salt, cooking oil and black pepper are always assumed.</p>

<form method="post">
    @foreach (var group in Model.Groups)
    {
        <fieldset class="mb-3">
            <legend>@group.Title</legend>
            @foreach (var option in group.Options)
            {
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" name="SelectedIds" value="@option.Id" id="ing-@option.Id" @(option.Selected ? "checked" : "") />
                    <label class="form-check-label" for="ing-@option.Id">@option.Name</label>
                </div>
            }
        </fieldset>
    }

    <button type="submit" class="btn btn-primary">Save pantry</button>
</form>

    {
      "name": "Chicken adobo",
      "description": "Chicken simmered in soy sauce, vinegar and garlic until the sauce turns glossy and savory-sour.",
      "cookingMethod": "Braised", "cookTimeMinutes": 45, "mainProtein": "chicken",
      "steps": [
        "Put the chicken, soy sauce, vinegar, garlic, pepper and bay leaf in a pot. Let it sit for 15 minutes if you have time.",
        "Add the water and bring to a boil without stirring, so the vinegar mellows.",
        "Lower the heat, cover, and simmer about 25 minutes until the chicken is tender.",
        "Uncover and simmer until the sauce thickens. Stir in the sugar if you like it a little sweet. Serve with rice."
      ],
      "ingredients": [
        { "name": "chicken", "quantity": 1, "unit": "kg", "isOptional": false },
        { "name": "soy sauce", "quantity": 0.5, "unit": "cup", "isOptional": false },
        { "name": "vinegar", "quantity": 0.5, "unit": "cup", "isOptional": false },
        { "name": "garlic", "quantity": 6, "unit": "cloves", "isOptional": false },
        { "name": "black pepper", "quantity": 1, "unit": "tsp", "isOptional": false },
        { "name": "bay leaf", "quantity": 2, "unit": "pcs", "isOptional": true },
        { "name": "water", "quantity": 0.5, "unit": "cup", "isOptional": false },
        { "name": "sugar", "quantity": 1, "unit": "tbsp", "isOptional": true }
      ]
    },
